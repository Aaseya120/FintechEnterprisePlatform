type Query {
    accountByNumber(accountNumber: String!): Account
    accountsByCustomer(customerId: String!): [Account]
    accountBalance(accountNumber: String!): BalanceInfo
    legacyCbsAccount(accountNumber: String!): LegacyCbsAccountInquiry
    legacyCbsHealth: LegacyCbsHealthStatus
    savingVaultsByCustomer(customerId: String!): [SavingVault]
    savingVaultById(vaultId: String!): SavingVault
}

type Mutation {
    openAccount(input: OpenAccountInput!): Account
    debitAccount(accountNumber: String!, amount: Float!): Account
    creditAccount(accountNumber: String!, amount: Float!): Account
    postLegacyCbsTransaction(input: LegacyCbsPostInput!): LegacyCbsPostResult
    createSavingVault(input: CreateSavingVaultInput!): SavingVault
    depositToVault(vaultId: String!, amount: Float!): SavingVault
    withdrawFromVault(vaultId: String!, amount: Float!): SavingVault
}

input OpenAccountInput {
    customerId: String!
    accountType: AccountType!
    currency: String!
    initialDeposit: Float!
}

input CreateSavingVaultInput {
    customerId: String!
    parentAccountNumber: String!
    vaultName: String!
    targetAmount: Float!
    currency: String!
    targetDate: String
    autoRoundupEnabled: Boolean
}

input LegacyCbsPostInput {
    transactionRef: String!
    sourceAccount: String!
    targetAccount: String!
    amount: Float!
    currency: String!
    narration: String!
}

enum AccountType {
    CHECKING
    SAVINGS
    MONEY_MARKET
    INVESTMENT
}

enum AccountStatus {
    ACTIVE
    DORMANT
    FROZEN
    CLOSED
}

enum LockStatus {
    LOCKED
    UNLOCKED
}

type Account {
    id: ID!
    accountNumber: String!
    customerId: String!
    accountType: AccountType!
    currency: String!
    balance: Float!
    availableBalance: Float!
    status: AccountStatus!
    createdAt: String
    updatedAt: String
}

type BalanceInfo {
    accountNumber: String!
    availableBalance: Float!
}

type SavingVault {
    id: ID!
    customerId: String!
    parentAccountNumber: String!
    vaultName: String!
    targetAmount: Float!
    currentBalance: Float!
    currency: String!
    targetDate: String
    lockStatus: LockStatus!
    autoRoundupEnabled: Boolean!
    progressPercentage: Float!
    createdAt: String
    updatedAt: String
}

type LegacyCbsAccountInquiry {
    legacyAccountRef: String!
    coreSystemName: String!
    ledgerBalance: Float!
    availableBalance: Float!
    currency: String!
    status: String!
    lastSyncedAt: String
}

type LegacyCbsPostResult {
    cbsHostRef: String!
    status: String!
    updatedBalance: Float!
    responseCode: String!
    message: String!
    postedAt: String
}

type LegacyCbsHealthStatus {
    coreSystem: String!
    endpointUrl: String!
    status: String!
    latencyMs: Int!
    timestamp: String
}
