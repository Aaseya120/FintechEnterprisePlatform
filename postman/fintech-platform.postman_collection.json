{
  "info": {
    "_postman_id": "9d8e7f6a-5b4c-3a21-9e8d-7c6b5a4f3e21",
    "name": "Fintech Enterprise Platform API",
    "description": "Postman test suite for Senior Java Developer Enterprise Microservices Architecture with JWT OAuth2, Distributed Tracing, Saga Outbox, and MinIO storage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (OAuth2 / JWT)",
      "item": [
        {
          "name": "Generate Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token acquired\", function () {",
                  "    pm.expect(jsonData.access_token).to.not.be.empty;",
                  "    pm.environment.set(\"jwt_token\", jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"senior.java.architect\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth/token",
              "host": ["{{gateway_url}}"],
              "path": ["auth", "token"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Orders & Distributed Transactions",
      "item": [
        {
          "name": "Create Order (Outbox + MinIO + gRPC Payment)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Order created successfully (201)\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Order Reference and MinIO URL present\", function () {",
                  "    pm.expect(jsonData.orderReference).to.not.be.empty;",
                  "    pm.expect(jsonData.invoiceDownloadUrl).to.not.be.empty;",
                  "    pm.environment.set(\"last_order_ref\", jsonData.orderReference);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "postman-trace-{{$timestamp}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"customerId\": \"CUST-98234\",\n    \"amount\": 3450.75,\n    \"currency\": \"USD\",\n    \"paymentMethod\": \"CREDIT_CARD\",\n    \"idempotencyKey\": \"idem-{{$guid}}\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/orders",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Get Order by Reference (Redis Cache Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order query status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "postman-trace-{{$timestamp}}"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/orders/{{last_order_ref}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "orders", "{{last_order_ref}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Payment & gRPC Service",
      "item": [
        {
          "name": "Payment Service Health & Status",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/api/payments/status",
              "host": ["{{gateway_url}}"],
              "path": ["api", "payments", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Observability & Gateway Actuator",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{gateway_url}}/actuator/health",
              "host": ["{{gateway_url}}"],
              "path": ["actuator", "health"]
            }
          }
        }
      ]
    }
  ]
}
